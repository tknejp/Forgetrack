rules_version = '2';

// Forgetrack Firestore security rules.
//
// **Identity model.** Every `users/{uid}/...` path is keyed by the
// Firebase Auth UID. `canonicalUid` in `lib/core/services/fcm_service.dart`
// and `Identity.fromFirebase` in `lib/features/auth/domain/identity.dart`
// both return `user.uid` (NOT the Google subject ID). Owner-only rules
// therefore use the standard `request.auth.uid == uid` comparison.
// Cloud Functions in `functions/index.js` propagate UIDs from document
// fields / path params, so they stay aligned automatically.
//
// **Deploy:** wired into `firebase.json`. Deploy with
// `firebase deploy --only firestore:rules`.
//
// **Scope:** this file covers the full Forgetrack ruleset (V2 ledger,
// goal history, cosmetic entitlements + hybrid sync, profiles, handles,
// friend requests, friendships, achievement shares, per-user
// notifications, devUsers admin grant). Field-level validation is
// pragmatic, not exhaustive — full rule hardening (e.g. forbidding
// profile fields outside an allowlist) is deferred to a dedicated
// security review.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── User profile ────────────────────────────────────────────────
    //
    // Peer reads needed for friend discovery and friend-list profile
    // chrome. Writes strictly self.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      // ── Per-user subcollections ───────────────────────────────────

      // Notifications: self-read, peer-write for cross-user reactions.
      // The reaction flow writes a doc id of `${shareId}_${actorUid}`
      // under the share OWNER's notifications subcollection. We allow
      // any signed-in caller to create here IF the doc declares them
      // as `actorUid` — the share owner reads + deletes their own.
      //
      // Updates fan out to two parties:
      //   * The OWNER updates to mark a notification read (`read: true`
      //     on `markNotificationsRead`).
      //   * The ACTOR updates to overwrite the previously-written
      //     reaction notification with a fresh emoji / timestamp when
      //     they re-react on the same share. The existing client used
      //     to `transaction.get` the notif first to short-circuit on
      //     existing docs, but that read isn't allowed for a non-owner
      //     actor — Firestore would deny the read, roll back the
      //     transaction, and the share-side reaction update would
      //     never land. The simpler, correct shape is to drop the
      //     read and let the actor overwrite their own row: a `set`
      //     by the actor is treated as `update` once the doc exists,
      //     so we have to allow it here. Both the OLD and NEW doc's
      //     `actorUid` must match `auth.uid` to prevent an attacker
      //     from hijacking somebody else's notification slot.
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow update: if isOwner(uid)
                      || (resource.data.actorUid == request.auth.uid
                          && request.resource.data.actorUid == request.auth.uid);
        allow create: if isSignedIn()
                      && request.resource.data.actorUid == request.auth.uid;
      }

      // Engine node completions: peer-read for friend hero profile,
      // self-write for the local ledger.
      match /engineNodeCompletions/{eventKey} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      // V2 engine ledger (rest): strictly self.
      match /engineObjectiveCompletions/{eventKey} {
        allow read, write: if isOwner(uid);
      }
      match /engineNodeClaims/{eventKey} {
        allow read, write: if isOwner(uid);
      }
      match /engineNodeAnnouncements/{eventKey} {
        allow read, write: if isOwner(uid);
      }
      match /engineRewardGrants/{eventKey} {
        allow read, write: if isOwner(uid);
      }
      match /engineQuestOfferings/{eventKey} {
        allow read, write: if isOwner(uid);
      }

      // Goal history (Trello #100): anti-cheat server truth.
      match /goal_history/{metricName} {
        allow read, write: if isOwner(uid);
      }

      // Cosmetic entitlements: client-read, Cloud-Functions-write.
      // The catchall below explicitly excludes this subcollection so
      // the write-deny here actually applies (Firestore evaluates all
      // matching rules with OR semantics — without the guard the
      // catchall would silently grant writes to the owner).
      match /cosmeticEntitlements/{cosmeticId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Cosmetic hybrid sync (Trello #110, 2026-05-26). Self-owned —
      // the local hybrid wrapper writes from the device. Listed
      // explicitly for documentation; the catchall below would cover
      // them too.
      match /cosmeticUnlocks/{cosmeticId} {
        allow read, write: if isOwner(uid);
      }
      match /cosmeticState/{docId} {
        allow read, write: if isOwner(uid);
      }

      // FCM tokens / per-user device data: self-only. Catches any
      // additional self-only subcollections under users/{uid} that
      // aren't carved out above.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid)
                            && subcollection != 'cosmeticEntitlements';
      }
    }

    // ── DevUsers (Trello #106) ──────────────────────────────────────
    //
    // Runtime dev-access grant for DevToolsPermissionService and the
    // future `isAdmin()` rule helper. Sentinel field `enabled: true`
    // flips dev access. Self-read only (so a peer can't discover
    // who's a dev). All writes denied for clients — managed via the
    // Firebase Console / admin scripts / future admin dashboard
    // callable functions.
    match /devUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Handles ─────────────────────────────────────────────────────
    //
    // Per-handle reservation doc carries an `uid` field. Any signed-in
    // user can read (for "is this handle taken" lookups) and the owner
    // can create / update / delete their own reservation.
    match /handles/{handle} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // ── Friend requests ─────────────────────────────────────────────
    //
    // Doc fields: fromUid, toUid, participantsKey, status, createdAt,
    // respondedAt. Creator is `fromUid`; either party reads; only the
    // recipient (`toUid`) updates status to accepted/declined.
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
                    && resource.data.toUid == request.auth.uid
                    && resource.data.fromUid == request.resource.data.fromUid
                    && resource.data.toUid == request.resource.data.toUid;
      // Deletes intentionally disallowed — declines flow through update.
      allow delete: if false;
    }

    // ── Friendships ─────────────────────────────────────────────────
    //
    // Doc carries a `members` array of 2 uids. Created inside the
    // accept-request transaction (caller must be one of the members);
    // delete is members-only (either party can unfriend); no updates.
    //
    // Read is open to any signed-in user. The app surfaces foreign
    // friend lists on every profile screen (count + sheet listing the
    // people they're friends with) and `sendFriendRequest` does an
    // existence probe by friendshipId before opening a new request —
    // both need to read docs the caller is not a member of (or that
    // don't exist yet). Privacy here matches the `users` collection,
    // which is also signed-in-readable.
    match /friendships/{friendshipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // ── App config (Trello #132) ────────────────────────────────────
    //
    // DIY in-app updater reads `app_config/latest_internal` to learn the
    // current internal-flavor build that's been uploaded to Firebase
    // Storage. The manifest is intentionally public — the APK at the
    // referenced storagePath is also public-readable (see storage.rules),
    // so gating the manifest behind auth would just add friction without
    // changing the exposure surface. Writes go through the release script
    // via Firebase Admin SDK (which bypasses rules), never from clients.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Achievement shares ──────────────────────────────────────────
    //
    // Doc fields: actorUid, achievementId, createdAt, message,
    // visibility, actorSnapshot, achievementSnapshot, reactions (map),
    // reactorSnapshots (map). Friends-visible reads are filtered on
    // the client today (visibility field + friend list); rules let any
    // signed-in caller read so the feed works. Reactions add/remove
    // entries to the `reactions` / `reactorSnapshots` maps from any
    // signed-in caller. Owner controls create + delete.
    match /achievement_shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
                    && resource.data.actorUid == request.auth.uid;
    }

    // Everything else: deny by default.
  }
}
