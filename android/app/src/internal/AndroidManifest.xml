<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        `internal` flavor only — required by Firebase App Distribution's
        in-app updater so the SDK can hand the downloaded APK to the
        Android package installer. NEVER add this to the main manifest
        (Play Store policy: REQUEST_INSTALL_PACKAGES needs an exception).
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!--
            firebase-appdistribution:16.0.0-beta14 manifest declares
            SignInResultActivity and InstallActivity without:

            1. android:theme — both extend AppCompatActivity and crash in
               onCreate with "You need to use a Theme.AppCompat theme"
               when launched under the app's default Flutter theme
               (descends from DeviceDefault, not AppCompat).

            2. android:taskAffinity — MainActivity has taskAffinity=""
               so the FAD activities inherit the package-default affinity
               ("com.knejp.forgetrack") and end up in a DIFFERENT task
               than MainActivity. Effect: after the Chrome Custom Tab
               sign-in returns, the user sees 2–3 separate Forgetrack
               cards in Recents (the MainActivity task, the FAD task with
               white screen, etc.) and the app appears to "close" before
               the update dialog finally shows on next reopen.

            Force matching affinity ("") so all activities share one task,
            and apply the same AppCompat theme the SDK's own
            FeedbackActivity uses (already in classpath transitively).
        -->
        <activity
            android:name="com.google.firebase.appdistribution.impl.SignInResultActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            tools:replace="android:theme,android:taskAffinity" />

        <activity
            android:name="com.google.firebase.appdistribution.impl.InstallActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            tools:replace="android:theme,android:taskAffinity" />
    </application>

</manifest>
